<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>fa</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q0_2_3">
			<x>180.0</x>
			<y>180.0</y>
			<label>{q0, q2, q3} does not end with 1</label>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>420.0</x>
			<y>180.0</y>
			<label>{q1} ends with 1</label>
			<final/>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>0</to>
			<read>0</read>
		</transition>
		<transition>
			<from>0</from>
			<to>1</to>
			<read>1</read>
		</transition>
		<transition>
			<from>1</from>
			<to>0</to>
			<read>0</read>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>1</read>
		</transition>
	</automaton>
</structure>

