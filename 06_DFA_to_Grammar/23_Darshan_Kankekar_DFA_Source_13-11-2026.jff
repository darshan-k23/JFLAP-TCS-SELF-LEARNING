<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>fa</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="qE">
			<x>180.0</x>
			<y>200.0</y>
			<label>even number of 1s</label>
			<initial/>
			<final/>
		</state>
		<state id="1" name="qO">
			<x>400.0</x>
			<y>200.0</y>
			<label>odd number of 1s</label>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>0</to>
			<read>0</read>
		</transition>
		<transition>
			<from>0</from>
			<to>1</to>
			<read>1</read>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>0</read>
		</transition>
		<transition>
			<from>1</from>
			<to>0</to>
			<read>1</read>
		</transition>
	</automaton>
</structure>

