<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>fa</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="A">
			<x>140.0</x>
			<y>150.0</y>
			<label>{q0}</label>
			<initial/>
		</state>
		<state id="1" name="B">
			<x>390.0</x>
			<y>150.0</y>
			<label>{q0, q1}</label>
		</state>
		<state id="2" name="C">
			<x>140.0</x>
			<y>360.0</y>
			<label>{q0, q2}</label>
			<final/>
		</state>
		<state id="3" name="D">
			<x>390.0</x>
			<y>360.0</y>
			<label>{q0, q1, q2}</label>
			<final/>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>a</read>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>b</read>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>a</read>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>b</read>
		</transition>
		<transition>
			<from>2</from>
			<to>3</to>
			<read>a</read>
		</transition>
		<transition>
			<from>2</from>
			<to>2</to>
			<read>b</read>
		</transition>
		<transition>
			<from>3</from>
			<to>3</to>
			<read>a</read>
		</transition>
		<transition>
			<from>3</from>
			<to>2</to>
			<read>b</read>
		</transition>
	</automaton>
</structure>

