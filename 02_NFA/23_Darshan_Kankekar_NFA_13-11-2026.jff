<?xml version="1.0" encoding="UTF-8"?>
<structure>
	<type>fa</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q0">
			<x>120.0</x>
			<y>180.0</y>
			<label>prefix loop / guess start</label>
			<initial/>
		</state>
		<state id="1" name="q1">
			<x>280.0</x>
			<y>180.0</y>
			<label>saw first a of suffix aa</label>
		</state>
		<state id="2" name="q2">
			<x>440.0</x>
			<y>180.0</y>
			<label>saw second a of suffix aa</label>
			<final/>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>0</to>
			<read>a</read>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>b</read>
		</transition>
		<transition>
			<from>0</from>
			<to>1</to>
			<read>a</read>
		</transition>
		<transition>
			<from>1</from>
			<to>2</to>
			<read>a</read>
		</transition>
	</automaton>
</structure>

